# Copy to .env for local runs. Set the same names in Vercel → Settings → Environment Variables.
# The web service never needs a private key. Only the scripts do.

# The registered agent wallet (public address): x402 payTo, AskBots funder, ERC-8004 owner.
AGENT_WALLET=0x0000000000000000000000000000000000000000
# Scripts only (register:8004, buy:test). Never set this on Vercel.
AGENT_PRIVATE_KEY=

# Issued at registration on celobuilders.xyz (celo_ + 12 hex). Appended to every tx the scripts send.
ATTRIBUTION_TAG=

# Facilitator key from https://x402.celo.org (connect wallet → create API key). Server-side secret.
X402_API_KEY=
X402_FACILITATOR_URL=https://api.x402.celo.org

# Public URL of this deployment, used in pay links and MCP descriptions.
PUBLIC_URL=https://counted.vercel.app

# Telegram bot from @BotFather, plus a random secret Telegram echoes on every webhook call.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Neon Postgres connection string. Without it the ledger is in-memory and labelled ephemeral.
DATABASE_URL=

# Dune API key (free tier) for /standing. Optional.
DUNE_API_KEY=
# Celoscan (Etherscan v2) key. Optional; resolves first funders of old wallets faster.
CELOSCAN_API_KEY=

# Operator-only endpoints and identifier hashing.
ADMIN_TOKEN=
HASH_SALT=

# Prices in USD, settled 1:1 in USA₮ / USDC / USD₮.
PRICE_CHECK_USD=0.05
PRICE_AUDIT_USD=1

# Local development only.
ALLOW_UNPAID=false
